# Optional CPU-only API image. The host deployment reuses its existing pinned privacy environment.
# Approved private documents and a matching reviewed corpus must be mounted read-only at runtime.
FROM python:3.10-slim
WORKDIR /srv/iam-sra
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils && rm -rf /var/lib/apt/lists/*
COPY requirements-app.txt requirements-privacy.txt requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-app.txt -r requirements-privacy.txt -r requirements-api.txt
COPY . .
ENV PYTHONPATH=/srv/iam-sra/src PYTHONDONTWRITEBYTECODE=1 IAM_SRA_API_PORT=8001
EXPOSE 8001
USER nobody
CMD ["python", "-m", "gunicorn", "--config", "configs/gunicorn_api.py", "iam_sra.api:create_app()"]

# Export in your shell; .env is not automatically sourced.
IAM_BASE_URL=http://127.0.0.1:8000
IAM_VLLM_PORT=8000
IAM_UI_PORT=8501
# Set IAM_GPU_UUID to the intended GPU on this host.
IAM_GPU_MEMORY_UTILIZATION=0.80
# Named local profiles: liono-v100s, liono-a2, davinci-v100, davinci-a30.
# For cross-host launch/tunnelling use scripts/model-host.py (docs/gpu-hosts.md).
# IAM_GPU_PROFILE=liono-a2
# IAM_CPU_OFFLOAD_GB=8  # automatic on <=18 GiB cards when unset
# For slower CPU-offloaded inference, set these on the API/application host:
# IAM_MODEL_TIMEOUT_SECONDS=900
# IAM_SRA_JOB_TIMEOUT=1800
# IAM_CHAT_PROCESSING_SECONDS=3600  # total model processing safeguard for slower interviews
IAM_MOCK=0
IAM_ASSESSMENT_MODE=general_baseline
